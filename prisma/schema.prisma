generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReportLog {
  id             Int      @id @default(autoincrement())
  tipo           String   @db.VarChar(50)
  formato        String   @db.VarChar(10)
  parametros     Json
  estado         String   @db.VarChar(20)
  fuentesFallidas String[] @default([])
  duracionMs     Int?
  bytesArchivo   Int?
  rutaArchivo    String?  @db.VarChar(500)
  usuarioId      Int
  sucursalId     Int?
  errorDetalle   String?  @db.VarChar(1000)
  createdAt      DateTime @default(now())

  @@map("reporte_logs")
}

model MetricaSnapshot {
  id             Int      @id @default(autoincrement())
  clave          String   @db.VarChar(80)
  valor          Decimal  @db.Decimal(18, 4)
  valorAnterior  Decimal? @db.Decimal(18, 4)
  variacionPct   Decimal? @db.Decimal(8, 2)
  sucursalId     Int?
  periodo        String   @db.VarChar(20)
  extras         Json?
  calculadoEn    DateTime @default(now())
  vigente        Boolean  @default(true)

  @@index([clave, sucursalId, periodo, vigente])
  @@map("metricas_snapshots")
}

model PlantillaReporte {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique @db.VarChar(100)
  tipo          String   @db.VarChar(50)
  configuracion Json
  activa        Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("plantillas_reporte")
}

model ReporteCache {
  id           Int      @id @default(autoincrement())
  claveHash    String   @unique @db.VarChar(64)
  tipo         String   @db.VarChar(50)
  formato      String   @db.VarChar(10)
  datos        Bytes
  bytesArchivo Int
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("reportes_cache")
}
